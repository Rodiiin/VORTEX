# ==============================================================================
# VORTEX - CONFIGURACIÓN DE VARIABLES DE ENTORNO (EJEMPLO)
# ==============================================================================

# --- Base de Datos (PostgreSQL) ---
DB_USER=vortex_user
DB_PASSWORD=vortex_secure_password
DB_NAME=vortex_db
DB_HOST=db
DB_PORT=5432

# Variables estándar para la imagen oficial de PostgreSQL
POSTGRES_USER=vortex_user
POSTGRES_PASSWORD=vortex_secure_password
POSTGRES_DB=vortex_db

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (Vite / React) ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
